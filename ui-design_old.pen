                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "oHbvA",
                      "fill": "#2B2620",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Precision Targeting Enables Undetectable Manipulation",
                      "lineHeight": 1.25,
                      "fontFamily": "Roboto",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "k8skvW",
                      "fill": "#5C564C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Micro-targeted political ads let campaigns show mutually contradictory messages to different voters without any single voter or watchdog seeing the full pattern. Platforms target by ZIP code, browsing history, and inferred political leaning, so different audience segments receive tailored — sometimes contradictory — messaging, with no unified public record of what was shown to whom.",
                      "lineHeight": 1.55,
                      "fontFamily": "Roboto",
                      "fontSize": 13.5,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Fge1s",
                      "name": "Impact",
                      "fill": "#5C564C",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "This erodes voters' ability to hold candidates accountable to one consistent platform. The harm reaches nearly every social-media-using voter and outweighs the Opposition's free-expression concerns, because it lands on the electorate's collective ability to know what it's voting for.",
                      "lineHeight": 1.55,
                      "fontFamily": "Roboto",
                      "fontSize": 13.5,
                      "fontWeight": "normal"
                    }
                  ]
                }
