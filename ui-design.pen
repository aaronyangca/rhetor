              "gap": 26,
              "children": [
                {
                  "type": "text",
                  "id": "rhcSW",
                  "name": "Eyebrow",
                  "fill": "$accent",
                  "content": "ANCIENT ROME · 1ST CENTURY BCE",
                  "fontFamily": "$font-primary",
                  "fontSize": 11,
                  "fontWeight": "700",
                  "letterSpacing": 2.6
                },
                {
                  "type": "text",
                  "id": "fdeJS",
                  "name": "History",
                  "fill": "#D9D3C6",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The rhetor was the last teacher a young Roman ever had — the master who took him at sixteen and taught him to stand before a hostile senate and win.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-secondary",
                  "fontSize": 19,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
