          "children": [
            {
              "type": "frame",
              "id": "f1uEh",
              "name": "Content",
              "width": 600,
              "layout": "vertical",
              "gap": 26,
              "children": [
                {
                  "type": "text",
                  "id": "rhcSW",
                  "name": "Eyebrow",
                  "fill": "$accent",
                  "content": "ANCIENT ROME · 1ST CENTURY BCE",
                  "fontFamily": "$font-primary",
                  "fontSize": 11,
                  "fontWeight": "700",
                  "letterSpacing": 2.6
                },
                {
                  "type": "text",
                  "id": "fdeJS",
                  "name": "History",
                  "fill": "#D9D3C6",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The rhetor was the last teacher a young Roman ever had — the master who took him at sixteen and taught him to stand before a hostile senate and win.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-secondary",
                  "fontSize": 19,
                  "fontStyle": "italic"
                },
                {
                  "type": "frame",
                  "id": "u7MW6l",
                  "name": "Rule",
                  "width": 64,
                  "height": 2,
                  "fill": "$accent"
                },
                {
                  "type": "text",
                  "id": "hYDRl",
                  "name": "Headline",
                  "fill": "#F7F1E5",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Two thousand years later, he's yours.",
                  "lineHeight": 1.12,
                  "fontFamily": "Fraunces",
                  "fontSize": 52,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "P10Os",
                  "name": "Subtext",
                  "fill": "#C3BCD4",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Rhetor takes your motion and builds the case the way that master would have — drafting arguments, scoring them against the standard real adjudicators judge by, and ranking what survives.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-primary",
                  "fontSize": 16
                },
                {
                  "type": "frame",
                  "id": "qO3Qd",
                  "name": "CtaRow",
                  "width": "fill_container",
                  "gap": 22,
                  "alignItems": "center",
