# Copy to .env and adjust as needed:  cp .env.example .env
# docker compose reads this file automatically. .env is gitignored — never commit it.

# --- Postgres container ---------------------------------------------------
POSTGRES_USER=rhetor
POSTGRES_PASSWORD=rhetor
POSTGRES_DB=rhetor
POSTGRES_TEST_DB=rhetor_test

# Host port the container publishes on. Change if 5432 is already taken
# (e.g. a Homebrew postgres) — then update the URLs below to match.
POSTGRES_PORT=5432

# Adminer, only started with `--profile tools`
ADMINER_PORT=8080

# --- Flask backend --------------------------------------------------------
# psycopg 3 driver. Use `postgresql://` instead if you're on psycopg2.
DATABASE_URL=postgresql+psycopg://rhetor:rhetor@localhost:5432/rhetor
TEST_DATABASE_URL=postgresql+psycopg://rhetor:rhetor@localhost:5432/rhetor_test

# Fernet key for encrypting users' BYOK API keys at rest (see webapp-design.md
# § Security). Generate a real one — do not use a shared or committed value:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Models ---------------------------------------------------------------
# Model is chosen per motion in the UI; see backend/app/llm/catalogue.py for
# the full list. These only change which option is offered as the *default*,
# and are ignored unless they name a model in that catalogue.
# OPENAI_MODEL=gpt-5.6-terra
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-3.5-flash
